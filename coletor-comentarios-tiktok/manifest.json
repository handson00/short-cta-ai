{
  "manifest_version": 3,
  "name": "Coletor de Comentarios TikTok",
  "version": "1.0.0",
  "description": "Captura os comentarios, as respostas e as hashtags do video do TikTok aberto na aba atual.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.tiktok.com/*", "http://localhost:*/*", "http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Coletor de Comentarios TikTok",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
