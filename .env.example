# ---------------------------------------------------------------------------
# Short CTA AI - configuracao local (usuario unico)
# Copie para .env.local e ajuste. Nunca versione o arquivo preenchido.
# ---------------------------------------------------------------------------

# Acesso a aplicacao. Todas as rotas de configuracao, teste e processamento
# exigem esta senha. Em producao local ela e obrigatoria.
APP_PASSWORD=troque-esta-senha
# 32+ bytes aleatorios: openssl rand -hex 32
APP_SESSION_SECRET=

# Chave mestra usada para criptografar a credencial do GhostCLI em repouso.
# Gere com: openssl rand -hex 32
SECRETS_MASTER_KEY=

# Credencial GhostCLI. Se definida aqui, tem precedencia sobre a chave salva
# pela interface e nunca e gravada no banco.
GHOSTCLI_API_KEY=
GHOSTCLI_BASE_URL=https://ghostcli.dev/v1
# Cabecalho de autenticacao: authorization (Bearer) ou x-api-key
GHOSTCLI_AUTH_HEADER=authorization

# Armazenamento local
DATA_DIR=./data

# Binarios externos (deixe em branco para usar o PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TESSERACT_PATH=tesseract

# Transcricao: faster-whisper | none
# Token que a extensao usa para enviar comentarios (POST /api/comments/ingest).
# Vazio = ingestao desativada.
COMMENTS_INGEST_TOKEN=

TRANSCRIPTION_PROVIDER=faster-whisper
FASTER_WHISPER_PYTHON=python3
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=pt

# Visao: tesseract (apenas OCR) | none
VISION_PROVIDER=tesseract
TESSERACT_LANGS=por+eng

# Pesquisa de obra: none | http
SEARCH_PROVIDER=none
SEARCH_HTTP_ENDPOINT=
SEARCH_HTTP_API_KEY=

# Worker embutido no processo do Next.js. Coloque false para rodar
# `npm run worker` em um processo separado.
WORKER_IN_PROCESS=true
