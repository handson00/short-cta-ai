{
  "name": "short-cta-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Esteira de preparacao de Shorts: importa videos em lote, analisa a cena e sugere CTAs persuasivos.",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx scripts/worker.ts",
    "fixtures": "bash scripts/make-fixtures.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:ghostcli": "node scripts/mock-ghostcli.mjs",
    "backfill:source": "tsx scripts/backfill-source.ts",
    "ocr:check": "tsx scripts/ocr-check.ts",
    "cta:debug": "tsx scripts/pipeline-debug.ts"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^16.3.5",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.4.2",
    "next": "15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
